# Copiar este archivo como .streamlit/secrets.toml y pegar la API key de Gemini.
# El archivo real está en .gitignore: la credencial nunca se sube al repositorio.
#
# La key se obtiene en https://aistudio.google.com/apikey
#
# En Streamlit Community Cloud no se sube ningún archivo: el mismo contenido se
# pega en Settings → Secrets.
#
# Con la key definida acá (o en la variable de entorno GEMINI_API_KEY), la app
# entra en modo asesor: no muestra el panel de credencial ni el selector de
# modelo. Para abrir ese panel puntualmente, agregar ?config=1 a la URL.

GEMINI_API_KEY = "AIza..."

# Opcional: fija el modelo que usará la app. Si se omite, usa el recomendado; y
# si la API key no habilita el elegido, cae automáticamente al mejor disponible.
# GEMINI_MODEL = "gemini-3.5-flash"
